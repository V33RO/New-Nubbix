# Proveedor activo: openai | anthropic
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

# Anthropic (se usa a partir del Paso 9)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Parámetros de la llamada
TEMPERATURE=0.0
MAX_TOKENS=400

# none = sin razonamiento interno (necesario para tool calling en este modelo)
REASONING_EFFORT=none

